# Addresses of the three deployed contracts on GenLayer Studionet.
# Fill these in after running the deploy runbook in docs/DEPLOY-STUDIONET.md.
#
# There is no key of any kind here, and there must never be one. Anything
# prefixed VITE_ is compiled into the shipped bundle and is publicly readable.
# MetaMask signs every write; the app only ever holds addresses.

VITE_ESCROW_ADDRESS=0x57c7fA920F4407d084E47ED5E05fCfc7d56D9e00
VITE_POLICY_ADDRESS=0xb757eC8a9824Eb956072d7E6Bc5D5bC4ad597CAb
VITE_REPUTATION_ADDRESS=0xea3DDF603bBDFDcdEA1a9F92FCeE95c42C3daC26
